# Public GitHub analysis is unauthenticated by default. Add a token only when
# your deployment is authorized to analyze private repositories.
# GITHUB_TOKEN=

# Server-side Gemini configuration for evidence-grounded PRD generation.
# Never expose this key through NEXT_PUBLIC_* variables or commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
